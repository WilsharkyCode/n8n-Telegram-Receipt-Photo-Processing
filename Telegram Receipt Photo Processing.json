    {
      "parameters": {
        "jsCode": "const message = $input.first().json.message;\nif (!message.photo) throw new Error('No photo found');\nconst file_id = message.photo[message.photo.length - 1].file_id;\nconst submissionDate = new Date().toISOString().slice(0, 10);\nreturn [{\n  json: {\n    file_id,\n    chatId: message.chat.id,\n    messageId: message.message_id,\n    submissionDate,\n    folderName: submissionDate,\n    fileName: `receipt_${submissionDate}_${message.chat.id}.jpg`\n  }\n}];"
      },
      "id": "74bb352b-b43b-48e3-97b9-3d40e51d4ed4",
