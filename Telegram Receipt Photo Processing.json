    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binaryBuffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst b64 = binaryBuffer.toString('base64');\nconst mimeType = item.binary?.data?.mimeType || 'image/jpeg';\nconst prompt = `Extract merchant, amount, currency, and date (YYYY-MM-DD) from this receipt. Return ONLY valid JSON.`;\nreturn [{\n  json: {\n    ...item.json,\n    body: {\n      contents: [{\n        role: 'user',\n        parts: [\n          { text: prompt },\n          { inlineData: { mimeType: mimeType, data: b64 } }\n        ]\n      }],\n      generationConfig: { responseMimeType: 'application/json' }\n    }\n  },\n  binary: item.binary\n}];"
      },
      "id": "c34cb868-8ad3-43cf-bdb3-147405fd32b5",
      "name": "Build Gemini Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -272,
        784
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "4588f6bc-2cd3-4115-a674-19465c95e308",
      "name": "Call Gemini Vision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -48,
        784
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst rawText = item.json.candidates[0].content.parts[0].text;\nconst cleanedText = rawText.replace(/```json|```/g, '').trim();\nconst data = JSON.parse(cleanedText);\nconst meta = $('Extract Metadata').first().json;\nreturn [{\n  json: {\n    merchant: data.merchant,\n    amount: data.amount,\n    currency: data.currency,\n    transactionDate: data.date,\n    submissionDate: meta.submissionDate,\n    folderName: meta.folderName,\n    fileName: meta.fileName,\n    chatId: meta.chatId\n  },\n  binary: item.binary\n}];"
      },
